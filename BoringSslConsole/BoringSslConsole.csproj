<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Target Name="CopyNativeLibrary" AfterTargets="Build">
    <ItemGroup>
      <NativeLibraries Include="$(MSBuildProjectDirectory)/../Native/build/proxymap_boringssl.dll" Condition="Exists('$(MSBuildProjectDirectory)/../Native/build/proxymap_boringssl.dll')" />
      <NativeLibraries Include="$(MSBuildProjectDirectory)/../Native/build/libproxymap_boringssl.so" Condition="Exists('$(MSBuildProjectDirectory)/../Native/build/libproxymap_boringssl.so')" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeLibraries)" DestinationFolder="$(OutputPath)" />
  </Target>
</Project>
