<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native library: .dll for Windows, .so for Linux. CopyToOutputDirectory
         items flow transitively through ProjectReference to test projects. -->
    <None Include="../Native/build/proxymap_boringssl.dll"
          Link="proxymap_boringssl.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../Native/build/proxymap_boringssl.dll')" />
    <None Include="../Native/build/libproxymap_boringssl.so"
          Link="libproxymap_boringssl.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('../Native/build/libproxymap_boringssl.so')" />
  </ItemGroup>
  <Target Name="EnsureNativeLibrary" BeforeTargets="Build"
          Condition="!Exists('../Native/build/proxymap_boringssl.dll') AND !Exists('../Native/build/libproxymap_boringssl.so')">
    <Warning Text="Native library not found in ../Native/build. Run Native/build.ps1 (Windows) or Native/build.sh (Linux) first." />
  </Target>
</Project>
